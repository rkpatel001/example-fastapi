[Unit]
Description=demo fastapi application
After=network.target

[Service]
User=ronak
Group=ronak
WorkingDirectory=/home/fastapi/app/src/
Environment = "PATH=/home/fastapi/app/venv/bin"
EnvironmentFile = /home/ronak/.env
ExecStart=/home/fastapi/app/venv/bin/gunicorn -w 4 -k uvicorn.workers.uvicornWorker app.
main:app --bind 0.0.0.0:8000


[Install]

wantedBy=multi-user.target


